<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Sign up"
        android:textColor="@color/text_dark"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Join as a member &amp; experience more fun from various meal at Kopi dan Nyemil app"
        android:textColor="@color/text_muted"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="64dp" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/coffee_dark"
        android:text="Register"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/white"
        android:text="Login"
        android:textColor="@color/coffee_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:strokeColor="@color/coffee_dark"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp" />

</LinearLayout>
